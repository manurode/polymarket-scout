# ============================================================
# Polymarket Scout — API Keys
# ============================================================
# Copia este archivo a .env y rellena con tus credenciales:
#   cp .env.example .env
#
# NUNCA versionar .env  (ya está en .gitignore)

# ── Polymarket CLOB API ────────────────────────────────────
# Credenciales para la API del CLOB (orderbook, trading, WS)
# Obtenlas en: https://polymarket.com/settings/api-keys
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# ── Wallet / Polygon (on-chain) ───────────────────────────
# Dirección del wallet y clave privada para ejecución real
# 🔐 NO versionar la private key jamás
POLYGON_ADDRESS=
POLYGON_PRIVATE_KEY=

# ── Telegram Alerts ───────────────────────────────────────
# (ya está en config.yaml, pero puedes sobrescribir aquí)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
